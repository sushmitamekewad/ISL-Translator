# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Dataset Settings (Supports direct ZIP loading without extraction)
DATASET_ZIP_PATH=dataset_ISL.zip
NUM_CLASSES=26
IMAGE_SIZE=224
BATCH_SIZE=32

# Model Configuration
# Options: mobilenet_v3_small | efficientnet_lite0 | yolo11n
DEFAULT_MODEL=mobilenet_v3_small
CHECKPOINT_DIR=models/checkpoints
EXPORT_DIR=models/onnx

# Sign Aggregation Settings (Debounce & Word Formation)
CONFIDENCE_THRESHOLD=0.70
CONSECUTIVE_FRAMES_THRESHOLD=8
SPACE_TIMEOUT_SECONDS=2.0
ENABLE_SPELLCHECK=True

# Deployment & Offline Settings
ALLOW_CLIENT_OFFLINE_FALLBACK=True
